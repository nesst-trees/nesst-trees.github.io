}

// "Tapped by mistake?" link: marks this tap as undone so it doesn't count
function undoHtml(token) {
  if (!token) return '';
  return `
<p class="undo"><button type="button" id="undo">Tapped by mistake? Remove this watering</button></p>
<script>
document.getElementById('undo').onclick = function() {
  var b = this;
  b.disabled = true; b.textContent = 'Removing\u2026';
  google.script.run.withSuccessHandler(function() {
    document.querySelector('h1').textContent = 'Watering removed';
    [].slice.call(document.querySelectorAll('.ln, .litres')).forEach(function(el) { el.remove(); });
    b.parentNode.textContent = 'This tap won\u2019t count. If you did water the tree, tap the tag again.';
  }).withFailureHandler(function(err) {
    b.disabled = false;
    b.textContent = 'Couldn\u2019t remove it' + (err && err.message ? ' (' + err.message + ')' : '') + '. Try again';
  }).undoWatering(${JSON.stringify(token)});
};
<\/script>`;
}
